# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# YouTube cookies file path (optional - for manual cookie auth)
# COOKIES_FILE=/path/to/cookies.txt

# PO Token server URL (optional)
# POT_SERVER_URL=http://localhost:4416

# Browser-based YouTube cookie extraction (default: true)
# Set to false to disable automatic browser cookie extraction
BROWSER_COOKIES_ENABLED=true
